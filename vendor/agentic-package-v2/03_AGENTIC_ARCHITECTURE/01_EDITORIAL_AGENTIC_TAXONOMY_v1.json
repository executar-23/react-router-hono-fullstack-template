    },
    "A1": {
      "name": "PREPARAR",
      "external_action": false,
      "description": "Produz plano ou artefato sem modificar sistemas externos."
    },
    "A2": {
      "name": "HUMAN_IN_THE_LOOP",
      "external_action": "after_human_approval",
      "description": "Agente prepara e humano autoriza."
    },
    "A3": {
      "name": "EXECUTAR",
      "external_action": true,
      "description": "Agente executa operacoes previamente autorizadas."
    },
    "A4": {
      "name": "EXECUTAR_VERIFICAR_EVIDENCIAR",
      "external_action": true,
      "description": "Executa, valida o resultado e registra evidencia."
    }
  },
