  "editorial_workflow": {
    "workflow_id": "WF-EDITORIAL-001",
    "version": "0.1.0",
    "status": "DRAFT",
    "stages": [
      {
        "stage_id": "STG-01",
        "name": "INTAKE",
        "purpose": "Receber e normalizar a materia-prima.",
        "primary_actor": "AGT-CLP-001",
        "supporting_actors": [
          "ACT-LEO-001"
        ],
        "input": [
          "audio",
          "texto",
          "notas",
          "briefing",
          "referencias"
        ],
        "output": [
          "normalized_input",
          "initial_context",
          "identified_gaps"
        ],
        "done_when": "entrada_normalizada_e_contexto_registrado"
      },
      {
        "stage_id": "STG-02",
        "name": "BRIEFING",
        "purpose": "Converter a entrada em contrato editorial executavel.",
        "primary_actor": "AGT-CLP-001",
        "output": [
          "objective",
          "audience",
          "scope",
          "constraints",
          "deliverables",
          "acceptance_criteria"
        ],
        "done_when": "execution_contract_ready"
      },
      {
        "stage_id": "STG-03",
        "name": "RESEARCH",
        "purpose": "Coletar fatos, referencias e evidencias necessarias.",
        "primary_actor": "AGT-RESEARCH-001",
        "output": [
          "research_package",
          "sources",
          "evidence",
          "conflicts",
          "gaps"
        ],
        "depends_on": [
          "STG-02"
        ],
        "done_when": "research_requirements_satisfied"
      },
      {
        "stage_id": "STG-04",
        "name": "EDITORIAL_ARCHITECTURE",
        "purpose": "Definir a estrutura narrativa e informacional.",
        "primary_actor": "AGT-EDITORIAL-STRATEGY-001",
        "output": [
          "content_structure",
          "narrative_flow",
          "section_plan",
          "content_requirements"
        ],
        "depends_on": [
          "STG-02",
          "STG-03"
        ],
        "done_when": "architecture_approved_or_auto_validated"
      },
      {
        "stage_id": "STG-05",
        "name": "DRAFT",
        "purpose": "Produzir a primeira versao completa.",
        "primary_actor": "AGT-WRITING-001",
        "output": [
          "draft_content"
        ],
        "depends_on": [
          "STG-04"
        ],
        "done_when": "full_draft_exists"
      },
      {
        "stage_id": "STG-06",
        "name": "EDITORIAL_REVIEW",
        "purpose": "Revisar clareza, estrutura, consistencia e aderencia.",
        "primary_actor": "AGT-EDITOR-001",
        "output": [
          "reviewed_content",
          "change_log"
        ],
        "depends_on": [
          "STG-05"
        ],
        "done_when": "editorial_acceptance_criteria_pass"
      },
      {
        "stage_id": "STG-07",
        "name": "FACT_CHECK",
        "purpose": "Validar afirmacoes verificaveis e evidencias.",
        "primary_actor": "AGT-FACTCHECK-001",
        "output": [
          "verified_claims",
          "source_map",
          "unresolved_claims"
        ],
        "depends_on": [
          "STG-06"
        ],
        "done_when": "all_required_claims_verified_or_flagged"
      },
      {
        "stage_id": "STG-08",
        "name": "DISCOVERY_OPTIMIZATION",
        "purpose": "Aplicar requisitos de descoberta, distribuicao e SEO quando aplicavel.",
        "primary_actor": "AGT-SEO-001",
        "output": [
          "metadata",
          "search_structure",
          "internal_linking_requirements",
          "distribution_requirements"
        ],
        "depends_on": [
          "STG-06"
        ],
        "done_when": "discovery_requirements_pass"
      },
      {
        "stage_id": "STG-09",
        "name": "PUBLICATION_TRANSFORM",
        "purpose": "Converter o conteudo para o formato tecnico de publicacao.",
        "primary_actor": "AGT-MDX-001",
        "output": [
          "publication_ready_artifact"
        ],
        "depends_on": [
          "STG-07",
          "STG-08"
        ],
        "done_when": "artifact_is_technically_valid"
      },
      {
        "stage_id": "STG-10",
        "name": "HUMAN_APPROVAL",
        "purpose": "Obter decisao humana quando exigida.",
        "primary_actor": "ACT-LEO-001",
        "condition": "human_approval_required_equals_true",
        "output": [
          "approved",
          "rejected",
          "revision_requested"
        ],
        "depends_on": [
          "STG-09"
        ],
        "done_when": "human_decision_registered"
      },
      {
        "stage_id": "STG-11",
        "name": "PUBLISH",
        "purpose": "Executar a publicacao quando autorizada.",
        "primary_actor": "AGT-CLP-001",
        "required_automation_level": "A3_or_A4",
        "output": [
          "publication_reference",
          "execution_log"
        ],
        "depends_on": [
          "STG-09",
          "STG-10_if_required"
        ],
        "done_when": "publication_action_confirmed"
      },
      {
        "stage_id": "STG-12",
        "name": "VERIFY",
        "purpose": "Confirmar que o estado final esperado realmente foi alcancado.",
        "primary_actor": "AGT-QA-001",
        "output": [
          "verification_result",
          "evidence"
        ],
        "depends_on": [
          "STG-11"
        ],
        "done_when": "expected_state_verified"
      },
      {
        "stage_id": "STG-13",
        "name": "LEARNING",
        "purpose": "Registrar resultado e aprendizado reutilizavel.",
        "primary_actor": "AGT-CLP-001",
        "output": [
          "learning_record",
          "metrics",
          "improvement_candidates"
        ],
        "depends_on": [
          "STG-12"
        ],
        "done_when": "run_closed_with_evidence"
      }
    ]
  },
  "handoff_contract": {
    "id": "HANDOFF-EDITORIAL-001",
    "required_fields": [
      "handoff_id",
