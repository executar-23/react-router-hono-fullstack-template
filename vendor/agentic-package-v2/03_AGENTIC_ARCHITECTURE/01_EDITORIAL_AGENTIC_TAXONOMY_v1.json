{
  "schema": {
    "id": "EXECUTAR-AI-EDITORIAL-TAXONOMY-001",
    "version": "1.0.0",
    "language": "pt-BR",
    "status": "DRAFT",
    "type": "agent_operating_model",
    "area": "Linha de Producao Editorial",
    "workflow": "Editorial AI Production",
    "owner": "A_DEFINIR",
    "source": "conteudo_fornecido_pelo_usuario"
  },
  "objective": {
    "primary": "Estruturar uma linha de producao editorial controlada, rastreavel e orientada por agentes de IA.",
    "secondary": [
      "Definir quem faz o que",
      "Definir o que cada ator entrega",
      "Definir quando cada ator entra no processo",
      "Separar orquestracao, agentes, skills, ferramentas e dados",
      "Controlar autonomia e permissoes",
      "Exigir verificacao e evidencia antes de considerar trabalho concluido"
    ]
  },
  "core_principles": [
    {
      "id": "PRINCIPLE-001",
      "rule": "LLM_NAO_E_WORKFLOW_ENGINE",
      "description": "Estados, condicoes, retries, permissoes, timeouts, versionamento, transacoes e aprovacoes devem permanecer no orquestrador sempre que forem deterministicos."
    },
    {
      "id": "PRINCIPLE-002",
      "rule": "WIP_1",
      "description": "Executar somente um no operacional por vez, salvo paralelismo explicitamente definido pelo workflow."
    },
    {
      "id": "PRINCIPLE-003",
      "rule": "NO_SILENT_INFERENCE",
      "description": "Dados ausentes nao devem ser inventados. Utilizar A_DEFINIR."
    },
    {
      "id": "PRINCIPLE-004",
      "rule": "DONE_REQUIRES_EVIDENCE",
      "description": "Um agente nao pode declarar DONE apenas porque produziu uma resposta. O resultado deve ser verificado e evidenciado."
    },
    {
      "id": "PRINCIPLE-005",
      "rule": "LEAST_PRIVILEGE",
      "description": "Cada agente, skill e connector recebe somente as permissoes necessarias para sua funcao."
    }
  ],
  "taxonomy": {
    "production_line": {
      "id": "EDITORIAL-LINE-001",
      "name": "Linha de Producao Editorial",
      "hierarchy": [
        "BPM",
        "Workflow",
        "Agent",
        "Skill",
        "Tool_or_Connector",
        "Data",
        "Observability"
      ]
    },
    "semantic_definition": {
      "BPM": "Define O QUE acontece no processo de negocio.",
      "Workflow": "Define QUANDO acontece e EM QUE ORDEM.",
      "Agent": "Resolve tarefas nao deterministicas dentro de limites definidos.",
      "Skill": "Define COMO executar uma capacidade ou procedimento conhecido.",
      "Connector": "Concede acesso controlado a um sistema externo.",
      "Tool": "Executa uma acao concreta.",
      "Policy": "Define SE a acao pode ocorrer.",
      "Data": "Fornece entradas e contexto autorizado.",
      "Log_or_Evidence": "Comprova O QUE realmente aconteceu."
    }
  },
  "actors": [
    {
      "actor_id": "ACT-LEO-001",
      "name": "Leo",
      "type": "human_creator",
      "role": "Creator Humano",
      "authority": "human_final_authority",
      "responsibilities": [
        "Definir direcao criativa quando necessario",
        "Fornecer conhecimento, opiniao, experiencia e materia-prima humana",
        "Resolver decisoes exclusivamente humanas",
        "Aprovar conteudo quando o workflow exigir human-in-the-loop",
        "Autorizar acoes externas quando requerido",
        "Intervir em conflitos ou excecoes nao solucionaveis automaticamente"
      ],
      "deliverables": [
        {
          "deliverable": "input_criativo",
          "when": "inicio_do_workflow_ou_quando_solicitado"
        },
        {
          "deliverable": "decisao_humana",
          "when": "human_approval_gate"
        },
        {
          "deliverable": "aprovacao_final",
          "when": "quando_configurada_como_obrigatoria"
        }
      ],
      "automation_level": "HUMAN"
    },
    {
      "actor_id": "AGT-CLP-001",
      "name": "CLP",
      "expanded_name": "Creator Lead Platform",
      "type": "principal_agent",
      "role": "Orchestrator",
      "authority": "bounded_orchestration",
      "responsibilities": [
        "Receber o objetivo editorial",
        "Interpretar o estado do workflow",
        "Selecionar o proximo no executavel",
        "Delegar trabalho para subagentes especializados",
        "Aplicar contratos de handoff",
        "Verificar dependencias",
        "Aplicar policies e limites",
        "Solicitar intervencao humana quando necessario",
        "Consolidar resultados",
        "Garantir verificacao e evidencia",
        "Atualizar estado operacional"
      ],
      "must_not": [
        "Ignorar approval gates",
        "Inventar dados ausentes",
        "Conceder permissoes a si mesmo",
        "Substituir regras deterministicas do workflow",
        "Declarar DONE sem verificacao"
      ],
      "deliverables": [
        {
          "deliverable": "execution_plan",
          "when": "apos_intake"
        },
        {
          "deliverable": "task_assignment",
          "when": "antes_de_cada_handoff"
        },
        {
          "deliverable": "consolidated_output",
          "when": "apos_execucao_dos_subagentes"
        },
        {
          "deliverable": "verification_record",
          "when": "antes_de_DONE"
        },
        {
          "deliverable": "run_evidence",
          "when": "encerramento_do_run"
        }
      ]
    },
    {
      "actor_id": "AGT-SUB-PLACEHOLDER",
      "name": "Subagentes Especialistas",
      "type": "specialized_subagents",
      "role": "Especialistas por Area e Funcao",
      "status": "PLACEHOLDER",
      "instances": [
        {
          "agent_id": "AGT-EDITORIAL-STRATEGY-001",
          "area": "estrategia_editorial",
          "function": "Planejamento e enquadramento",
          "status": "A_DEFINIR"
        },
        {
