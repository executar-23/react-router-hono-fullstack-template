/**
 * Worker principal: app React Router + API Hono (/api/*).
 * Docs: https://developers.cloudflare.com/workers/wrangler/configuration/
 * Variáveis públicas ficam em "vars"; segredos NUNCA aqui (wrangler secret put).
 * Inventário completo: docs/adr/ENV-INVENTORY.md
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"account_id": "92fdc1b556435f2e3d62517f3041422e",
	"name": "react-router-hono-fullstack-template",
	"compatibility_date": "2025-10-08",
	"main": "./workers/app.ts",
	"vars": {
		"ENVIRONMENT": "production",
		// Origem do app (CSRF). Troque se usar domínio customizado.
		"ALLOWED_ORIGIN": "https://react-router-hono-fullstack-template.hub-executar.workers.dev",
		// Servidor OpenAuth (Worker separado em auth/).
		"AUTH_ISSUER_URL": "https://hub-editorial-auth.hub-executar.workers.dev",
		"AUTH_CLIENT_ID": "hub-editorial",
		"ADMIN_EMAIL": "executar-rotina@outlook.com",
		"PROJECT_CONTACT": "executar-rotina@outlook.com"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "hub-editorial-db",
			"database_id": "e1e1d9c4-3ff3-4055-bd11-0613b93ca2fe",
			"migrations_dir": "migrations"
		}
	],
	"workflows": [
		{
			"name": "hub-publish",
			"binding": "HUB_PUBLISH_WORKFLOW",
			"class_name": "HubPublishWorkflow"
		}
	],
	"previews": {
		// Previews usam um D1 de staging próprio (nunca o de produção). Migrações:
		// wrangler d1 migrations apply DB --remote --config wrangler.preview-migrations.jsonc
		// O Workflow só pode ser ligado a um Workflow já existente (após o 1º deploy de produção).
		"d1_databases": [
			{
				"binding": "DB",
				"database_name": "hub-editorial-db-preview",
				"database_id": "4266dc35-c9f3-4f4e-83a8-8468f8da4478"
			}
		],
		"vars": {
			"ENVIRONMENT": "preview",
			"ALLOWED_ORIGIN": "REPLACE_IN_PREVIEW",
			"AUTH_ISSUER_URL": "REPLACE_IN_PREVIEW",
			"AUTH_CLIENT_ID": "hub-editorial",
			"ADMIN_EMAIL": "executar-rotina@outlook.com",
			"PROJECT_CONTACT": "executar-rotina@outlook.com"
		}
	},
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true
}

