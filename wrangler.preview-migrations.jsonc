/**
 * Só para aplicar migrações ao D1 de staging dos previews (ADR-001):
 *   npx wrangler d1 migrations apply DB --remote --config wrangler.preview-migrations.jsonc
 * Precisa apontar para o mesmo banco de previews.d1_databases em wrangler.jsonc.
 */
{
	"name": "react-router-hono-fullstack-template-preview-migrations",
	"compatibility_date": "2025-10-08",
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "hub-editorial-db-preview",
			"database_id": "4266dc35-c9f3-4f4e-83a8-8468f8da4478",
			"migrations_dir": "migrations"
		}
	]
}
