{
	"name": "react-router-hono-fullstack-template",
	"description": "A modern full-stack template powered by Cloudflare Workers, using Hono for backend APIs, React Router for frontend routing, and shadcn/ui for beautiful, accessible components styled with Tailwind CSS",
	"cloudflare": {
		"label": "React Router + Hono Fullstack App",
		"products": [
			"Workers"
		],
		"categories": [
			"starter"
		],
		"docs_url": "https://developers.cloudflare.com/workers",
		"preview_icon_url": "https://imagedelivery.net/wSMYJvS3Xw-n339CbDyDIA/d3db20ee-c3bf-4b5c-f1ed-d86021359e00/public",
		"preview_image_url": "https://imagedelivery.net/wSMYJvS3Xw-n339CbDyDIA/56caa8a9-d3ab-4ac6-32a9-6a5fc686e000/preview",
		"publish": true
	},
	"dependencies": {
		"@openauthjs/openauth": "^0.4.3",
		"@radix-ui/react-accordion": "^1.2.12",
		"@radix-ui/react-alert-dialog": "^1.1.15",
		"@radix-ui/react-aspect-ratio": "^1.1.7",
		"@radix-ui/react-avatar": "^1.1.10",
		"@radix-ui/react-checkbox": "^1.3.3",
		"@radix-ui/react-collapsible": "^1.1.12",
		"@radix-ui/react-context-menu": "^2.2.16",
		"@radix-ui/react-dialog": "^1.1.15",
		"@radix-ui/react-dropdown-menu": "^2.1.16",
		"@radix-ui/react-hover-card": "^1.1.15",
		"@radix-ui/react-label": "^2.1.7",
		"@radix-ui/react-menubar": "^1.1.16",
		"@radix-ui/react-navigation-menu": "^1.2.14",
		"@radix-ui/react-popover": "^1.1.15",
		"@radix-ui/react-progress": "^1.1.7",
		"@radix-ui/react-radio-group": "^1.3.8",
		"@radix-ui/react-scroll-area": "^1.2.10",
		"@radix-ui/react-select": "^2.2.6",
		"@radix-ui/react-separator": "^1.1.7",
		"@radix-ui/react-slider": "^1.3.6",
		"@radix-ui/react-slot": "^1.2.3",
		"@radix-ui/react-switch": "^1.2.6",
		"@radix-ui/react-tabs": "^1.1.13",
		"@radix-ui/react-toggle": "^1.1.10",
		"@radix-ui/react-toggle-group": "^1.1.11",
		"@radix-ui/react-tooltip": "^1.2.8",
		"@tailwindcss/typography": "^0.5.19",
		"chanfana": "^2.8.3",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"cmdk": "^1.1.1",
		"embla-carousel-react": "^8.6.0",
		"hono": "4.11.1",
		"input-otp": "^1.4.2",
		"isbot": "5.1.32",
		"lucide-react": "^0.545.0",
		"react": "19.2.1",
		"react-day-picker": "^9.11.1",
		"react-dom": "19.2.1",
		"react-hook-form": "^7.65.0",
		"react-resizable-panels": "^3.0.6",
		"react-router": "7.9.6",
		"recharts": "^2.15.4",
		"tailwind-merge": "^3.3.1",
		"tw-animate-css": "^1.4.0",
		"valibot": "^1.2.0",
		"vaul": "^1.1.2",
		"zod": "^3.25.67"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "1.52.1",
		"@cloudflare/vitest-pool-workers": "^0.21.3",
		"@cloudflare/workers-types": "^5.20260921.1",
		"@eslint/js": "^9.39.5",
		"@react-router/dev": "7.9.6",
		"@tailwindcss/vite": "4.1.17",
		"@types/node": "24.10.1",
		"@types/react": "19.2.7",
		"@types/react-dom": "19.2.3",
		"@vitest/runner": "^4.1.10",
		"@vitest/snapshot": "^4.1.10",
		"eslint": "^9.39.5",
		"eslint-plugin-react-hooks": "^7.1.1",
		"globals": "^17.12.0",
		"tailwindcss": "4.1.17",
		"typescript": "5.9.3",
		"typescript-eslint": "^8.71.0",
		"vite": "^7.0.0",
		"vite-tsconfig-paths": "5.1.4",
		"vitest": "^4.1.10",
		"wrangler": "4.136.1"
	},
	"private": true,
	"scripts": {
		"build": "react-router build",
		"cf-typegen": "wrangler types",
		"check": "npm run lint && npm run typecheck && npm run test && npm run build && npm run check:env && wrangler deploy --dry-run && wrangler deploy --dry-run -c auth/wrangler.jsonc",
		"check:env": "node scripts/check-env.mjs",
		"db:migrate:auth:remote": "wrangler d1 migrations apply AUTH_DB --remote -c auth/wrangler.jsonc",
		"db:migrate:local": "wrangler d1 migrations apply DB --local",
		"db:migrate:preview": "wrangler d1 migrations apply DB --remote --config wrangler.preview-migrations.jsonc",
		"db:migrate:remote": "wrangler d1 migrations apply DB --remote",
		"db:seed:generate": "node scripts/generate-seed.mjs",
		"db:seed:local": "wrangler d1 execute DB --local --file db/seed.sql",
		"db:seed:remote": "wrangler d1 execute DB --remote --file db/seed.sql",
		"deploy": "npm run build && wrangler deploy",
		"deploy:auth": "wrangler deploy -c auth/wrangler.jsonc",
		"dev": "react-router dev",
		"dev:auth": "wrangler dev -c auth/wrangler.jsonc --port 8788",
		"lint": "eslint . --max-warnings 0",
		"plan:generate": "node scripts/generate-execution-plan.mjs",
		"preview": "npm run build && vite preview",
		"test": "vitest run",
		"typecheck": "npm run cf-typegen && react-router typegen && tsc -b",
		"validate:state": "node scripts/validate-execution-state.mjs",
		"validate:workflow": "node scripts/validate-workflow.mjs"
	},
	"type": "module"
}
