# Hub Editorial — ambiente: test (versionado, sem segredos)
# Placeholders: CHANGE_ME / TBD / REPLACE_IN_PRODUCTION. Nunca comite valores reais.
# Inventário e contratos: docs/adr/ENV-INVENTORY.md

# ---- Worker principal (app + API) ----
# development | preview | test | production
ENVIRONMENT=test
# Origem do app (checagem CSRF na API). Sem barra final.
ALLOWED_ORIGIN=http://local.test
# URL do servidor OpenAuth (Worker auth/).
AUTH_ISSUER_URL=http://auth.local.test
# Client id do app no OpenAuth (igual nos dois Workers).
AUTH_CLIENT_ID=hub-editorial
# E-mail do único administrador (autorização).
ADMIN_EMAIL=executar-rotina@outlook.com
# Contato/identificação do projeto.
PROJECT_CONTACT=executar-rotina@outlook.com

# ---- Worker de autenticação (auth/) ----
# Remetente do código de login (domínio verificado no provedor).
EMAIL_FROM=executar-rotina@outlook.com
# SEGREDO. Chave do Resend (envio do código). Só via `wrangler secret put`.
RESEND_API_KEY=CHANGE_ME

# ---- Deploy / CI ----
# ID da conta Cloudflare (deploy/CI).
CLOUDFLARE_ACCOUNT_ID=CHANGE_ME
# SEGREDO. Token de API do Cloudflare (deploy/CI). Permissões: Workers Scripts:Edit, D1:Edit, Workers KV:Edit.
CLOUDFLARE_API_TOKEN=CHANGE_ME

# ---- Reservado ----
# RESERVADO (nenhum código consome hoje). Integração 'cloud.ai' a confirmar — ver ADR-001 §Premissas.
CLOUD_AI_BASE_URL=TBD
# RESERVADO / SEGREDO. Idem.
CLOUD_AI_API_KEY=CHANGE_ME
