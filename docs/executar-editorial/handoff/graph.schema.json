{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:executar:design:graph:0.1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "version",
    "mode",
    "nodes",
    "edges"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "const": "0.1.0"
    },
    "mode": {
      "enum": [
        "hierarchy",
        "flow",
        "mindmap",
        "agents"
      ]
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "title",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "root",
              "branch",
              "task",
              "decision",
              "agent",
              "tool",
              "approval",
              "input",
              "output"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "description": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 4000
          },
          "status": {
            "enum": [
              "NOT_READY",
              "READY",
              "IN_PROGRESS",
              "BLOCKED",
              "DECLARED_DONE",
              "VERIFIED"
            ]
          },
          "owner": {
            "type": [
              "string",
              "null"
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "expanded": {
            "type": "boolean",
            "default": true
          },
          "groupId": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "source",
          "target",
          "relation"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "target": {
            "type": "string",
            "minLength": 1
          },
          "relation": {
            "enum": [
              "hierarchy",
              "dependency",
              "sequence",
              "message",
              "return"
            ]
          },
          "label": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 120
          }
        }
      }
    }
  },
  "$comment": "IDs únicos, referências, ciclos, WIP e evidência são validados pela camada de domínio; ver handoff."
}
